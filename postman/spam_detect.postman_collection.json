{
  "info": {
    "name": "AI Spam Detector API",
    "description": "API для определения спама в тексте с сохранением истории",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:1001/health",
          "host": ["localhost"],
          "port": "1001",
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "Analyze - Spam",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-APIKEY",
            "value": "000000-000000-000000-00000-000000"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"CONGRATULATIONS! You won $1,000,000! Click here to claim your prize now!\"\n}"
        },
        "url": {
          "raw": "http://localhost:1001/analyze",
          "host": ["localhost"],
          "port": "1001",
          "path": ["analyze"]
        }
      },
      "response": []
    },
    {
