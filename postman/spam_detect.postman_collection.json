        "url": {
          "raw": "http://localhost:1001/analyze",
          "host": ["localhost"],
          "port": "1001",
          "path": ["analyze"]
        }
      },
      "response": []
    },
    {
      "name": "Get History (with pagination)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:1001/history?page=1&limit=10",
          "host": ["localhost"],
          "port": "1001",
          "path": ["history"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "response": []
